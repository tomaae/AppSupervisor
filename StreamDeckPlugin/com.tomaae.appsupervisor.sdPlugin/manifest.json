{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "static/imgs/action-list/status",
      "Name": "Status",
      "States": [
        {
          "Image": "static/imgs/keys/offline",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF",
          "FontSize": 12
        }
      ],
      "Tooltip": "Shows AppSupervisor status and opens configuration when pressed.",
      "UUID": "com.tomaae.appsupervisor.status",
      "UserTitleEnabled": false
    },
    {
      "Controllers": [
        "Keypad"
      ],
      "Icon": "static/imgs/action-list/launch",
      "Name": "Launch monitored app",
      "PropertyInspectorPath": "static/property-inspector/launch.html",
      "States": [
        {
          "Image": "static/imgs/keys/launch",
          "TitleAlignment": "bottom",
          "TitleColor": "#FFFFFF",
          "FontSize": 12
        }
      ],
      "Tooltip": "Launches the monitored process for a selected enabled profile.",
      "UUID": "com.tomaae.appsupervisor.launch-profile",
      "UserTitleEnabled": false
    }
  ],
  "Author": "Tomaae",
  "Category": "AppSupervisor",
  "CategoryIcon": "static/imgs/category/appsupervisor",
  "CodePath": "bin/plugin.js",
  "Description": "Shows AppSupervisor status and launches monitored profile applications from Stream Deck keys.",
  "Icon": "static/imgs/plugin/appsupervisor",
  "Name": "AppSupervisor",
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.6"
  },
  "UUID": "com.tomaae.appsupervisor",
  "Version": "1.0.0.4"
}
